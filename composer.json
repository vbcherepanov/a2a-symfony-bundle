{
  "name": "vbcherepanov/a2a-symfony-bundle",
  "description": "Symfony integration for the A2A 1.0 PHP SDK",
  "type": "symfony-bundle",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.4",
    "doctrine/dbal": "^4.3",
    "monolog/monolog": "^3.9",
    "symfony/console": "^7.4 || ^8.0",
    "symfony/framework-bundle": "^7.4 || ^8.0",
    "symfony/messenger": "^7.4 || ^8.0",
    "symfony/security-core": "^7.4 || ^8.0",
    "symfony/security-http": "^7.4 || ^8.0",
    "vbcherepanov/a2a-php-sdk": "^1.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.90",
    "grpc/grpc": "^1.74",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "^7.4 || ^8.0",
    "symfony/process": "^7.4 || ^8.0",
    "symfony/yaml": "^7.4 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "A2A\\Bundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "A2A\\Bundle\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpstan analyse --no-progress --memory-limit=1G",
    "style": "php-cs-fixer fix --dry-run --diff",
    "build": "@php tests/build.php",
    "package": "@php tools/check-package.php"
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  },
  "keywords": [
    "a2a",
    "symfony",
    "bundle",
    "agent-to-agent",
    "json-rpc",
    "grpc",
    "sse"
  ],
  "homepage": "https://github.com/vbcherepanov/a2a-symfony-bundle",
  "support": {
    "issues": "https://github.com/vbcherepanov/a2a-symfony-bundle/issues",
    "source": "https://github.com/vbcherepanov/a2a-symfony-bundle"
  },
  "archive": {
    "exclude": [
      "/.github",
      "/.dockerignore",
      "/.env*",
      "/.gitattributes",
      "/.gitignore",
      "/.php*",
      "/Dockerfile*",
      "/Makefile",
      "/compose*.yml",
      "/composer.lock",
      "/dist",
      "/docs/SESSION*",
      "/docs/TASKS.md",
      "/docs/PROGRESS.md",
      "/docs/*.txt",
      "/phpstan.neon",
      "/phpunit*.xml",
      "/tests",
      "/tools",
      "/var",
      "/vendor"
    ]
  }
}
