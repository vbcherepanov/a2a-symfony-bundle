BUNDLE_IMAGE=a2a-symfony-bundle-dev:local
BUNDLE_UID=1000
BUNDLE_GID=1000
BUNDLE_SOURCE=.
BUNDLE_WORKDIR=/workspace/a2a-symfony-bundle
HEALTH_INTERVAL=30s
HEALTH_TIMEOUT=5s
HEALTH_RETRIES=3
POSTGRES_TEST_IMAGE=a2a-symfony-bundle-postgres:local
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_TEST_HOST=postgres
POSTGRES_TEST_PORT=5432
POSTGRES_TEST_DB=a2a_test
POSTGRES_TEST_USER=a2a_test
POSTGRES_TEST_PASSWORD=local-test-password
POSTGRES_TEST_DATA_DIR=/var/lib/postgresql
POSTGRES_TEST_HEALTH_INTERVAL=1s
POSTGRES_TEST_HEALTH_TIMEOUT=5s
POSTGRES_TEST_HEALTH_RETRIES=30
